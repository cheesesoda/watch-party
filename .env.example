WATCH_PASSWORD=change-me
MEDIA_PATH=/path/to/your/movies
# Optional: movie and episode details. The "API Read Access Token" from themoviedb.org/settings/api
TMDB_TOKEN=
# Optional: Find subtitles. An API key from opensubtitles.com (avatar, API consumers), and that account's sign-in
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
