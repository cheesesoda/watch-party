<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Replaces Media3's style for the player's seek bar (Media3 builds the bar with this style). A slightly
        thicker bar and a bigger dot, like YouTube on TV; the dot only shows while the bar is selected (RoomActivity).
    -->
    <style name="ExoStyledControls.TimeBar" parent="">
        <item name="bar_height">5dp</item>
        <item name="touch_target_height">32dp</item>
        <item name="scrubber_enabled_size">18dp</item>
        <item name="scrubber_disabled_size">0dp</item>
        <item name="scrubber_dragged_size">22dp</item>
        <item name="bar_gravity">center</item>
    </style>

    <!-- The TV controls' round buttons (tv_player_controls); RoomActivity gives them the white focused circle. -->
    <style name="TvPlayerButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@null</item>
    </style>

    <!-- The TV controls' time and "Up next" line. -->
    <style name="TvPlayerTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:fontFamily">@font/barlow_regular</item>
    </style>

    <!-- The phone controls' time and "Up next" line (phone_player_controls). -->
    <style name="PhonePlayerTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:fontFamily">@font/barlow_regular</item>
    </style>

    <!-- The phone seek bar's dot: small while the controls show, larger while it's dragged (PhoneTimeBar). -->
    <dimen name="phone_scrubber_enabled">14dp</dimen>
    <dimen name="phone_scrubber_dragged">20dp</dimen>
</resources>
