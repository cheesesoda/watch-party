<?xml version="1.0" encoding="utf-8"?>
<!--
    The phone's player controls, like YouTube's: what's on and the party's buttons along the top, play/pause in the
    middle (previous and next beside it in a binge), and the time, what's next and the seek bar along the bottom.
    Media3 runs the views with exo_ ids; RoomActivity puts the title and buttons in phone_top and draws the shade.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/phone_shade"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        RoomActivity adds the top bar (thumbnail, title, party line and buttons) here, and moves Media3's subtitle
        button into the bar's row of buttons.
    -->
    <FrameLayout
        android:id="@+id/phone_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top">

        <ImageButton
            android:id="@id/exo_subtitle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/exo_controls_cc_disabled_description"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tv_cc_off" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/phone_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:contentDescription="@string/exo_controls_play_description"
            android:padding="18dp"
            android:scaleType="fitCenter" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/phone_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-4dp"
            android:gravity="center_vertical">

            <TextView android:id="@id/exo_position" style="@style/PhonePlayerTime" />

            <TextView style="@style/PhonePlayerTime" android:text=" / " />

            <TextView android:id="@id/exo_duration" style="@style/PhonePlayerTime" />

            <TextView
                android:id="@+id/phone_up_next"
                style="@style/PhonePlayerTime"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="24dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1" />

        </LinearLayout>

        <!-- RoomActivity pulls the bar out by the dot's half width, so the line itself lines up with the time. -->
        <com.watchparty.app.PhoneTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            app:bar_height="4dp"
            app:buffered_color="#B3FFFFFF"
            app:played_color="@color/accent"
            app:scrubber_color="@color/accent"
            app:scrubber_disabled_size="0dp"
            app:scrubber_dragged_size="@dimen/phone_scrubber_dragged"
            app:scrubber_enabled_size="@dimen/phone_scrubber_enabled"
            app:touch_target_height="32dp"
            app:unplayed_color="#4DFFFFFF" />

    </LinearLayout>

    <!--
        Media3's audio track and speed menu opens from here. Never shown: the Settings button offers it, so the top
        row has one gear. Media3 places the menu at the right edge, measured from the start of the screen, so this sits
        at the start; the menu ends up just above the seek bar at the right.
    -->
    <View
        android:id="@id/exo_settings"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="64dp"
        android:visibility="invisible" />

</merge>
