<?xml version="1.0" encoding="utf-8"?>
<!-- The TV's player: Media3's PlayerView with the TV controls (tv_player_controls) in place of Media3's own. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:controller_layout_id="@layout/tv_player_controls"
    app:pause_icon="@drawable/ic_pause_filled"
    app:play_icon="@drawable/ic_play_filled"
    app:subtitle_off_icon="@drawable/ic_tv_cc_off"
    app:subtitle_on_icon="@drawable/ic_tv_cc" />
